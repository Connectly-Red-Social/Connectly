# Variables de entorno (copia este archivo a .env)

# Base de datos MySQL. Si no se define, se usa el respaldo local:
#   mysql+pymysql://root:Nicolas20@localhost:3306/connectly
# En Render: la URL de tu MySQL de producción con el prefijo mysql+pymysql://
DATABASE_URL=mysql+pymysql://usuario:password@host:3306/connectly

# Clave secreta de Flask (genera una segura en producción)
SECRET_KEY=cambia-esto

# Opcional: ruta alternativa del dataset para la carga inicial
# SEED_CSV_PATH=../data/SocialMediaUsersDataset.csv

# Administrador inicial (se crea al primer arranque si no existe ninguno).
# Si no defines ADMIN_PASSWORD se usa "admin": cámbiala en producción.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto
